DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver
# Set a unique secret before deploying.
DJANGO_SECRET_KEY=development-only-change-before-deploying-please
# Docker Compose supplies DATABASE_URL and REDIS_URL.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=exercise@localhost
REPORT_EMAIL=
# To send email, set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# Optional server-side S3 storage; credentials use the standard AWS provider chain.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-2
# AWS_MEDIA_BASE_URL=https://your-media-domain.example
